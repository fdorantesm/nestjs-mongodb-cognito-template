# Environment used by test runners (jest e2e).
# Copy to .env.testing and fill in or override as needed.
# Variables with defaults below are safe to leave as-is for unit/e2e.

# General
NODE_ENV=test
DEBUG=false

# Server
PORT=3001
HOST=localhost

# Database
DB_HOST=localhost
DB_PORT=27017
DB_USERNAME=root
DB_PASSWORD=secret
DB_DATABASE=nestjs_test

# JWT
JWT_SECRET=test-jwt-secret
JWT_EXPIRES=365d

# Encryption (32 hex chars minimum)
APP_ENCRYPTION_KEY=e1b7a9d0448477a2d4e8c3f20b9f653c

# Cognito (use mocks; identity service is overridden in e2e specs)
COGNITO_REGION=us-east-1
COGNITO_USER_POOL_ID=us-east-1_TESTPOOLID
COGNITO_CLIENT_ID=test-client-id
COGNITO_CLIENT_SECRET=test-client-secret

# Anti-throttle (relaxed values for tests)
ANTI_THROTTLE_MAX_REQUEST=10000
ANTI_THROTTLE_INTERVAL=1000
RATE_MAX_REQUEST=10000
RATE_INTERVAL=1000

# Docker Compose (optional, prevents collisions with default .env)
COMPOSE_PROJECT_NAME=nestjs-mongodb-cognito-template-test
